# =============================================================================
# SaffronPass Environment Variables
# Copy this file to .env.local for local development and add the same keys
# in your Vercel Project Settings -> Environment Variables.
# =============================================================================

# Your Supabase project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable Key (new standard: sb_publishable_...)
# If your project still uses legacy keys, you can set NEXT_PUBLIC_SUPABASE_ANON_KEY instead;
# the app automatically falls back to NEXT_PUBLIC_SUPABASE_ANON_KEY when PUBLISHABLE is unset.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Secret Key (new standard: sb_secret_... or legacy service_role JWT)
# SERVER-ONLY! NEVER prefix with NEXT_PUBLIC_ and NEVER expose in client code.
# Used exclusively by server-side guest invite lookups and RSVP submission handlers
# so public tables remain 100% locked down against anonymous database queries.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# Canonical site URL (no trailing slash). Used for OAuth redirects and share links.
# Local: http://localhost:3000 | Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
